// Mã Hex     // Lệnh Assembly       // Giải thích logic (Giá trị mong đợi)

00002083      // lw  x1, 0(x0)       // Đọc số 10 từ RAM vào thanh ghi x1
00402103      // lw  x2, 4(x0)       // Đọc số 5 từ RAM vào thanh ghi x2
002081b3      // add x3, x1, x2      // x3 = 10 + 5 = 15
40208233      // sub x4, x1, x2      // x4 = 10 - 5 = 5
0020f2b3      // and x5, x1, x2      // x5 = 10 (1010) AND 5 (0101) = 0
0020e333      // or  x6, x1, x2      // x6 = 10 (1010) OR 5 (0101) = 15
001123b3      // slt x7, x2, x1      // So sánh: 5 < 10 là Đúng -> x7 = 1
00302423      // sw  x3, 8(x0)       // Ghi giá trị 15 (của x3) xuống địa chỉ 8 trong RAM
00108063      // beq x1, x1, 0       // Vì x1 == x1, PC nhảy tại chỗ (PC + 0), CPU dừng